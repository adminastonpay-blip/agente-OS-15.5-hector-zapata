{% comment %} ASTON AI Surface Scanner — independent Shopify section {% endcomment %}
<section id="aston-surface-scanner-{{ section.id }}" class="aston-scanner">
  <div class="aston-scanner__shell">
    <div class="aston-scanner__eyebrow"><span></span> ASTON SECURITY INTELLIGENCE</div>
    <h2>{{ section.settings.heading | escape }}</h2>
    <p class="aston-scanner__intro">{{ section.settings.description | escape }}</p>
    <form class="aston-scanner__form" novalidate>
      <label for="aston-scan-url-{{ section.id }}">Ingresá la URL de tu empresa</label>
      <input id="aston-scan-url-{{ section.id }}" name="url" type="url" placeholder="https://empresa.com" autocomplete="url" required>
      <button type="submit" class="aston-scanner__button">Escanear Superficie de Ataque <span aria-hidden="true">↗</span></button>
      <p class="aston-scanner__privacy">Análisis pasivo de la respuesta pública. No se realizan pruebas de explotación.</p>
    </form>
    <div class="aston-scanner__loading" hidden aria-live="polite">
      <div class="aston-scanner__loading-top"><span class="scan-status">Preparando revisión segura…</span><span class="scan-percent">0%</span></div>
      <div class="aston-scanner__track"><span></span></div>
      <div class="aston-scanner__steps"><span>Conexión HTTP</span><span>Cabeceras</span><span>Exposición pública</span><span>Informe</span></div>
    </div>
    <div class="aston-scanner__error" role="alert" hidden></div>
    <div class="aston-scanner__results" hidden aria-live="polite">
      <div class="aston-scanner__result-head">
        <div><div class="aston-scanner__eyebrow">SURFACE REVIEW COMPLETE</div><h3>Resultado de la evaluación</h3><p class="scan-host"></p></div>
        <div class="aston-scanner__score" role="img" aria-label="Security score"><strong>—</strong><span>SECURITY SCORE</span></div>
      </div>
      <div class="aston-scanner__findings"><h4>Hallazgos detectados</h4><ul></ul><p class="scan-clean" hidden>No se detectaron los patrones revisados en esta respuesta.</p></div>
      <div class="aston-scanner__report"><div class="aston-scanner__eyebrow">ASTON AI BUSINESS REPORT</div><p class="scan-report"></p><p class="scan-recommendation"></p></div>
      <p class="aston-scanner__disclaimer">Evaluación pasiva y limitada. No constituye pentest, auditoría integral ni certificación. Los patrones de secretos pueden incluir falsos positivos.</p>
      <a class="aston-scanner__button aston-scanner__sales" href="mailto:{{ section.settings.sales_email | escape }}?subject=ASTON%20Enterprise%20Pilot%20-%20Diagn%C3%B3stico%20de%207%20d%C3%ADas">Solicitar Diagnóstico Completo de 7 Días (Enterprise Pilot) <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
<style>
#aston-surface-scanner-{{ section.id }}{--as-bg:#090b10;--as-panel:#121722;--as-gold:#c9a66b;--as-muted:#9aa4b3;background:radial-gradient(ellipse at 80% 0%,#202b3d 0,transparent 45%),var(--as-bg);color:#f4f5f7;padding:76px 22px;font-family:inherit}
#aston-surface-scanner-{{ section.id }} *{box-sizing:border-box}
#aston-surface-scanner-{{ section.id }} .aston-scanner__shell{max-width:940px;margin:auto}
#aston-surface-scanner-{{ section.id }} .aston-scanner__eyebrow{font-size:10px;letter-spacing:2px;color:var(--as-gold);font-weight:700}
#aston-surface-scanner-{{ section.id }} .aston-scanner__eyebrow span{display:inline-block;width:7px;height:7px;border-radius:50%;background:#6ed3a4;margin-right:9px}
#aston-surface-scanner-{{ section.id }} h2{font-size:clamp(32px,5vw,54px);line-height:1.08;letter-spacing:-1.7px;margin:18px 0}
#aston-surface-scanner-{{ section.id }} .aston-scanner__intro{color:#b5bfcd;max-width:680px;font-size:16px;line-height:1.7}
#aston-surface-scanner-{{ section.id }} .aston-scanner__form{margin-top:34px;padding:26px;background:var(--as-panel);border:1px solid #293243;border-radius:12px;display:grid;gap:13px}
#aston-surface-scanner-{{ section.id }} label{font-size:13px;font-weight:700}
#aston-surface-scanner-{{ section.id }} input{width:100%;padding:16px 17px;border-radius:7px;border:1px solid #3a4658;background:#090d14;color:#fff;font:inherit}
#aston-surface-scanner-{{ section.id }} input:focus{outline:2px solid var(--as-gold);outline-offset:2px}
#aston-surface-scanner-{{ section.id }} .aston-scanner__button{display:inline-flex;justify-content:center;align-items:center;gap:12px;padding:16px 22px;border:0;border-radius:7px;background:var(--as-gold);color:#101114;font-weight:800;font-size:13px;text-align:center;text-decoration:none;cursor:pointer}
#aston-surface-scanner-{{ section.id }} .aston-scanner__button:disabled{opacity:.55;cursor:wait}
#aston-surface-scanner-{{ section.id }} .aston-scanner__privacy,#aston-surface-scanner-{{ section.id }} .aston-scanner__disclaimer{font-size:11px;color:#8994a4;margin:0}
#aston-surface-scanner-{{ section.id }} .aston-scanner__loading,#aston-surface-scanner-{{ section.id }} .aston-scanner__results{margin-top:22px;padding:25px;background:var(--as-panel);border:1px solid #293243;border-radius:12px}
#aston-surface-scanner-{{ section.id }} .aston-scanner__loading-top{display:flex;justify-content:space-between;font-size:12px;color:#dce1e9}
#aston-surface-scanner-{{ section.id }} .aston-scanner__track{height:7px;background:#252e3b;border-radius:9px;overflow:hidden;margin:14px 0}
#aston-surface-scanner-{{ section.id }} .aston-scanner__track span{display:block;width:0;height:100%;background:var(--as-gold);transition:width .3s}
#aston-surface-scanner-{{ section.id }} .aston-scanner__steps{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;color:#8792a2;font-size:10px}
#aston-surface-scanner-{{ section.id }} .aston-scanner__error{margin-top:18px;padding:16px;border:1px solid #9d4a4a;color:#ffb4b4;background:#301919;border-radius:8px}
#aston-surface-scanner-{{ section.id }} .aston-scanner__result-head{display:flex;justify-content:space-between;align-items:center;gap:20px}
#aston-surface-scanner-{{ section.id }} h3{font-size:24px;margin:8px 0}
#aston-surface-scanner-{{ section.id }} .scan-host{font-size:12px;color:var(--as-muted)}
#aston-surface-scanner-{{ section.id }} .aston-scanner__score{width:150px;height:150px;flex:0 0 150px;border-radius:50%;border:8px solid #d69a42;display:flex;flex-direction:column;justify-content:center;align-items:center}
#aston-surface-scanner-{{ section.id }} .aston-scanner__score strong{font-size:48px;line-height:1;font-weight:800}
#aston-surface-scanner-{{ section.id }} .aston-scanner__score span{font-size:8px;letter-spacing:1px;margin-top:8px}
#aston-surface-scanner-{{ section.id }} .aston-scanner__findings{margin-top:28px}
#aston-surface-scanner-{{ section.id }} h4{margin:0 0 12px;font-size:15px}
#aston-surface-scanner-{{ section.id }} .aston-scanner__findings ul{list-style:none;padding:0;margin:0;display:grid;gap:10px}
#aston-surface-scanner-{{ section.id }} .aston-scanner__findings li{padding:14px;border:1px solid #303b4c;border-radius:8px;background:#0d121a}
#aston-surface-scanner-{{ section.id }} .finding-title{font-size:13px;font-weight:800}
#aston-surface-scanner-{{ section.id }} .finding-meta{font-size:9px;letter-spacing:1px;color:var(--as-gold);margin-left:8px}
#aston-surface-scanner-{{ section.id }} .finding-description,#aston-surface-scanner-{{ section.id }} .finding-evidence{font-size:12px;color:#aab4c2;margin:6px 0 0}
#aston-surface-scanner-{{ section.id }} .aston-scanner__report{margin-top:22px;padding:20px;border-left:2px solid var(--as-gold);background:#0c1119}
#aston-surface-scanner-{{ section.id }} .scan-report{font-size:14px;line-height:1.75;color:#e0e4eb}
#aston-surface-scanner-{{ section.id }} .scan-recommendation{font-size:12px;color:#d7bd91}
#aston-surface-scanner-{{ section.id }} .aston-scanner__disclaimer{margin:18px 0}
#aston-surface-scanner-{{ section.id }} .aston-scanner__sales{width:100%;margin-top:8px}
@media(max-width:600px){#aston-surface-scanner-{{ section.id }}{padding:54px 16px}#aston-surface-scanner-{{ section.id }} .aston-scanner__result-head{align-items:flex-start;flex-direction:column}#aston-surface-scanner-{{ section.id }} .aston-scanner__score{width:128px;height:128px;flex-basis:128px}#aston-surface-scanner-{{ section.id }} .aston-scanner__score strong{font-size:40px}}
</style>
<script>
(function(){
  var root=document.getElementById('aston-surface-scanner-{{ section.id }}');if(!root)return;
  var form=root.querySelector('form'),input=root.querySelector('input[name="url"]'),button=form.querySelector('button');
  var loading=root.querySelector('.aston-scanner__loading'),results=root.querySelector('.aston-scanner__results'),error=root.querySelector('.aston-scanner__error');
  var bar=root.querySelector('.aston-scanner__track span'),percent=root.querySelector('.scan-percent'),status=root.querySelector('.scan-status');
  var worker={{ section.settings.worker_url | json }};
  var timer=null,progress=0;
  function setProgress(n,label){progress=n;bar.style.width=n+'%';percent.textContent=n+'%';if(label)status.textContent=label;}
  function clearTimer(){if(timer){clearInterval(timer);timer=null;}}
  function safeText(value){return typeof value==='string'?value:'';}
  form.addEventListener('submit',async function(event){
    event.preventDefault();error.hidden=true;results.hidden=true;
    var target=input.value.trim();
    try{var parsed=new URL(target);if(!['http:','https:'].includes(parsed.protocol))throw new Error();}catch(_){error.textContent='Ingresá una URL HTTP o HTTPS válida.';error.hidden=false;return;}
    if(!worker){error.textContent='El escáner todavía no está configurado. Contactá al equipo ASTON.';error.hidden=false;return;}
    button.disabled=true;loading.hidden=false;setProgress(4,'Validando solicitud…');clearTimer();
    timer=setInterval(function(){if(progress<88){var next=Math.min(88,progress+Math.max(2,Math.round((88-progress)*.12)));setProgress(next,progress<30?'Conectando con el sitio…':progress<60?'Analizando cabeceras y contenido público…':'Preparando diagnóstico…');}},320);
    try{
      var controller=new AbortController(),timeout=setTimeout(function(){controller.abort();},12000);
      var response=await fetch(worker.replace(/\/$/, '')+'/api/scan',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({url:parsed.href}),signal:controller.signal,credentials:'omit'});
      clearTimeout(timeout);
      var data=await response.json().catch(function(){return null;});
      if(!response.ok||!data)throw new Error(data&&data.message?data.message:'No se pudo completar el análisis.');
      clearTimer();setProgress(100,'Evaluación finalizada');render(data,parsed.hostname);
    }catch(e){clearTimer();loading.hidden=true;error.textContent=e&&e.name==='AbortError'?'La solicitud superó el tiempo permitido. Intentá nuevamente.':(e.message||'Error al conectar con ASTON Scanner.');error.hidden=false;}
    finally{button.disabled=false;}
  });
  function render(data,host){
    loading.hidden=true;results.hidden=false;root.querySelector('.scan-host').textContent=host;
    var score=Math.max(0,Math.min(100,Number(data.score)||0)),ring=root.querySelector('.aston-scanner__score');
    ring.querySelector('strong').textContent=String(score);
    var color=score<50?'#e15e5e':score<80?'#d69a42':'#56b88a';ring.style.borderColor=color;
    var list=root.querySelector('.aston-scanner__findings ul');list.textContent='';
    var findings=Array.isArray(data.vulnerabilities)?data.vulnerabilities:[];
    root.querySelector('.scan-clean').hidden=findings.length>0;
    findings.forEach(function(item){
      var li=document.createElement('li'),title=document.createElement('div'),desc=document.createElement('p'),evidence=document.createElement('p'),meta=document.createElement('span');
      title.className='finding-title';title.textContent=safeText(item.title)||'Hallazgo';
      meta.className='finding-meta';meta.textContent=safeText(item.severity).toUpperCase();title.appendChild(meta);
      desc.className='finding-description';desc.textContent=safeText(item.description);
      evidence.className='finding-evidence';evidence.textContent=safeText(item.evidence);
      li.append(title,desc,evidence);list.appendChild(li);
    });
    root.querySelector('.scan-report').textContent=safeText(data.ai_report);
    root.querySelector('.scan-recommendation').textContent=safeText(data.recommendation);
  }
})();
</script>
{% schema %}
{
  "name": "ASTON Surface Scanner",
  "settings": [
    {"type":"text","id":"heading","label":"Título","default":"Conocé tu superficie de exposición."},
    {"type":"textarea","id":"description","label":"Descripción","default":"Una revisión pasiva de señales públicas para identificar oportunidades de mejora en la configuración de seguridad de tu sitio."},
    {"type":"url","id":"worker_url","label":"URL del Worker ASTON"},
    {"type":"text","id":"sales_email","label":"Email comercial","default":"hello@aston-os.com"}
  ],
  "presets":[{"name":"ASTON Surface Scanner"}]
}
{% endschema %}
