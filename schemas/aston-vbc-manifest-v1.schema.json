{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aston.example/schemas/aston-vbc-manifest-v1.schema.json",
  "title": "ASTON VBC-2030 Certificate Evidence Manifest",
  "description": "Canonical signed manifest binding a VBC certificate to an audit run, exact final PDF bytes, issuer identity and detached timestamp evidence. Replace example namespace before public release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "certificate_id",
    "issued_at",
    "issuer",
    "audit",
    "document",
    "timestamp",
    "policy"
  ],
  "properties": {
    "schema": {
      "const": "aston.vbc.manifest.v1"
    },
    "certificate_id": {
      "type": "string",
      "pattern": "^VBC-2030-[A-Z0-9-]{6,48}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legal_name",
        "issuer_id",
        "signing_key_id",
        "signature_profile"
      ],
      "properties": {
        "legal_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "issuer_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "signing_key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "signature_profile": {
          "type": "string",
          "enum": [
            "PAdES-B-B",
            "PAdES-B-T",
            "PAdES-B-LT",
            "PAdES-B-LTA"
          ]
        },
        "certificate_fingerprint_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "suite",
        "suite_version",
        "source_sha",
        "tenant_ref",
        "result",
        "controls"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "suite": {
          "const": "ARP-100"
        },
        "suite_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "tenant_ref": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "result": {
          "const": "PASS"
        },
        "controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "control_id",
              "result",
              "source_sha",
              "evidence_sha256"
            ],
            "properties": {
              "control_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "result": {
                "const": "PASS"
              },
              "source_sha": {
                "type": "string",
                "pattern": "^[a-f0-9]{40,64}$"
              },
              "evidence_sha256": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "waiver_id": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_type",
        "digest_algorithm",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "media_type": {
          "const": "application/pdf"
        },
        "digest_algorithm": {
          "const": "SHA-256"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "timestamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "proof_state"
      ],
      "properties": {
        "scheme": {
          "const": "OpenTimestamps"
        },
        "proof_state": {
          "type": "string",
          "enum": [
            "PENDING",
            "CONFIRMED",
            "UNAVAILABLE"
          ]
        },
        "proof_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bitcoin_block_height": {
          "type": "integer",
          "minimum": 1
        },
        "bitcoin_block_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bitcoin_block_time": {
          "type": "string",
          "format": "date-time"
        },
        "verifier_id": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "verification_profile"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "verification_profile": {
          "const": "VBC-2030-V1"
        },
        "privacy_profile": {
          "type": "string",
          "maxLength": 64
        }
      }
    }
  }
}
